[Unit]
Description=KVMem (vLLM SM75 fork backend, 2x RTX 2080 Ti); entry policy runs in-process, kvmem official port 18200
Documentation=file://%h/vllm-kvmem-adapter/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# Type=forking 的原因：vLLM 的 launcher.sh 会把引擎 setsid 到自己的会话里（父进程随后退出），
# 所以不能像 kvmem.service / kvmem-ninfer.service 那样用 Type=simple（那样单元会立刻变成 inactive）。
# 这里用 forking + PIDFile 跟踪真正的 api_server 进程。
PIDFile=%h/kvmem-vllm.pid
# User/Group 默认不写 = 以 root 运行；建议改成你的账号（或本机装成 systemd --user 单元）：
#User=srj
#Group=srj
WorkingDirectory=%h
Environment=HOME=%h
Environment=MALLOC_ARENA_MAX=2
# 覆盖项示例（改这些不必动 unit）：
# 参数写在 start-*.sh 里，不要写在这里（保持通用性）
# 入口策略（进程内中间件）随之派生，不需要单独配置：
# Environment=KVMEM_ENTRY_SELECT=retrieval KVMEM_ENTRY_HISTORY_KIB=64
# 指向你选定的站点配置脚本（start-*.sh），换配置就是换这一行
ExecStart=%h/start-kvmem-vllm.sh
TimeoutStartSec=900
TimeoutStopSec=120
Restart=on-failure
RestartSec=15
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target

# 注意: 本单元与 kvmem.service (llama.cpp 后端) 争用同一对 GPU，二者只能启一个。
# 入口策略已内联（vllm.endpoint_plugins: kvmem_entry），不再需要 kvmem-vllm-gateway.service。
