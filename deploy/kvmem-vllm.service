[Unit]
Description=KVMem (vLLM SM75 fork backend, 2x RTX 2080 Ti); entry policy runs in-process, kvmem official port 18200
Documentation=file://%h/vllm-kvmem-adapter/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# Type=forking 的原因：vLLM 的 launcher.sh 会把引擎 setsid 到自己的会话里（父进程随后退出），
# 所以不能像 kvmem.service / kvmem-ninfer.service 那样用 Type=simple（那样单元会立刻变成 inactive）。
# 这里用 forking + PIDFile 跟踪真正的 api_server 进程。
PIDFile=%h/kvmem-vllm.pid
# User/Group 默认不写 = 以 root 运行；建议取消注释并改成你的账号（或装成 systemd --user 单元）：
#User=your-user
#Group=your-group
WorkingDirectory=%h
Environment=HOME=%h
Environment=MALLOC_ARENA_MAX=2
# 可选：站点参数文件（存在则加载，不存在忽略）。内容 KEY=VALUE，一行一个。
EnvironmentFile=-%h/.config/kvmem-vllm.env
# 覆盖项示例（改这些不必动 unit）：
# 参数建议写进上面的 EnvironmentFile，或作为环境变量导出，不改 unit
# 入口策略（进程内中间件）随之派生，不需要单独配置：
# Environment=KVMEM_ENTRY_SELECT=retrieval KVMEM_ENTRY_HISTORY_KIB=64
ExecStart=%h/vllm-kvmem-adapter/deploy/run-current.sh
TimeoutStartSec=900
TimeoutStopSec=120
Restart=on-failure
RestartSec=15
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target

# 注意: 本单元与 kvmem.service (llama.cpp 后端) 争用同一对 GPU，二者只能启一个。
# 入口策略已内联（vllm.endpoint_plugins: kvmem_entry），不再需要 kvmem-vllm-gateway.service。
