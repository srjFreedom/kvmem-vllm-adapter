[Unit]
Description=KVMem vLLM backend (SM75, resident mode, port 18200)
Documentation=file://@REPO@/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# vLLM's launcher detaches the api_server into its own session, so the unit is
# Type=forking and tracks that PID. start-kvmem-vllm.sh writes it for us.
Type=forking
PIDFile=/run/kvmem-vllm/kvmem-vllm.pid
RuntimeDirectory=kvmem-vllm
RuntimeDirectoryMode=0755
User=@USER@
Group=@USER@
WorkingDirectory=@REPO@
Environment=HOME=@HOME@
Environment=MALLOC_ARENA_MAX=2
Environment=KV_PIDFILE=/run/kvmem-vllm/kvmem-vllm.pid
# Site parameters, both optional. NOTE the precedence: values from these files are
# already in the environment, so a startup script doing ${VAR:-default} keeps the FILE
# value and silently ignores its own default. Put MODEL / SERVED_NAME / budgets in the
# startup script (it then wins) and keep these files for machine-level knobs only.
EnvironmentFile=-/etc/default/kvmem-vllm
EnvironmentFile=-@HOME@/.config/kvmem-vllm.env
ExecStart=@START_SCRIPT@
TimeoutStartSec=900
TimeoutStopSec=120
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
