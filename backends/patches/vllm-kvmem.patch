+    n = int(_KEEP_N.get(int(layer), 0) or 0)
+    if keep is None or n <= 0 or take <= 0:
+        return None
+    count = min(int(take), n)
+    host = _KHOST.get(int(layer))
+    if host is None or host.shape[1] != keep.shape[1]:
+        host = torch.empty((keep.shape[0], keep.shape[1]), dtype=torch.float32, device="cpu")
+        _KHOST[int(layer)] = host
+    host[:count].copy_(keep[:count], non_blocking=False)
+    _KEEP_N[int(layer)] = 0          # one-shot per step
+    return host[:count]
+
+
+def _host_copy(view: torch.Tensor) -> torch.Tensor:
+    """Host copy of a device slice, never aliasing the source.
+
+    Two traps met in order: `.to("cpu")` returns the SAME tensor when it is already on CPU (so
+    zeroing the source zeroed the "copy" - every bucket read back 0), and dropping the `.to("cpu")`
+    to fix that handed numpy a CUDA tensor (`can't convert cuda:1 device type tensor to numpy`).
+    """
+    out = view.detach().to("cpu", non_blocking=False)
+    if out.data_ptr() == view.data_ptr():      # same-device .to() returned a view
+        out = out.clone()
+    return out.contiguous()
+
+
+def read_key_buckets(layer: int, span: int):
+    """Drain `layer`'s bucket sums for the step: float32 [span, width] host copy, or None.
+
+    Draining here (a step-boundary call, outside the graph) is what keeps the buffer per step
+    instead of per context: the context-sized copy lives in the adapter's RawKvStore.
+    """
+    acc = _KACC.get(int(layer))
+    if acc is None:
+        return None
+    take = max(0, min(int(span), int(acc.shape[0])))
+    if take == 0:
+        return None
+    host = _KHOST.get(int(layer))
+    if host is None or host.shape[1] != acc.shape[1] or host.device.type != "cpu":
+        host = torch.empty((acc.shape[0], acc.shape[1]), dtype=torch.float32, device="cpu")
+        _KHOST[int(layer)] = host
+    host[:take].copy_(acc[:take], non_blocking=False)     # reuse: no allocation, no pinning
+    try:
+        acc.zero_()
+    except Exception:
+        pass
+    return host[:take]
+
+
+def peek_key_buckets(layer: int, span: int):
+    """Same as read_key_buckets without draining (diagnostics / aborted steps)."""
+    acc = _KACC.get(int(layer))
+    if acc is None:
+        return None
+    take = max(0, min(int(span), int(acc.shape[0])))
+    if take == 0:
+        return None
+    return _host_copy(acc[:take])
+
+
+def key_diag():
+    """Key-capture counters (host sync per layer)."""
+    out = {"layers": len(_KACC), "buckets": _K_BUCKETS, "width": _KEY_WIDTH, "bad": {},
+           "mismatch": int(_K_MISMATCH[0]), "mismatch_info": dict(_K_MISMATCH_INFO)}
+    try:
+        for layer in sorted(_KFLAG):
+            count = int(_KFLAG[layer].item())
+            if count:
+                out["bad"][int(layer)] = count
+    except Exception:
+        pass
+    return out
+
+
+def capture_diag():
+    """Which layers were ever called, how often, with what payload shape, and which ever received a
+    non-finite query. One host sync per reported layer, so this is meant for reselect-time logging."""
+    out = {"calls": {}, "last_rows": {}, "nonfinite_layers": [], "last_count": {}}
+    try:
+        for layer in sorted(_query):
+            c = int(_calls.get(layer, 0))
+            if c <= 0:
+                continue
+            out["calls"][int(layer)] = c
+            shp = _shapes.get(layer)
+            if shp:
+                out["last_rows"][int(layer)] = int(shp[0])
+            flag = _bad.get(layer)
+            if flag is not None and int(flag.item()) > 0:
+                out["nonfinite_layers"].append(int(layer))
+            cnt = _count.get(layer)
+            if cnt is not None:
+                out["last_count"][int(layer)] = int(cnt.item())
+            nz = _nan.get(layer)
+            if nz is not None and int(nz.item()) > 0:
+                out.setdefault("nan_elems", {})[int(layer)] = int(nz.item())
+            iz = _inf.get(layer)
+            if iz is not None and int(iz.item()) > 0:
+                out.setdefault("inf_elems", {})[int(layer)] = int(iz.item())
+        out["probe"] = {int(k): v for k, v in list(_probe.items())[:4]}
+    except Exception:
+        pass
+    return out
+
+
+def read(layer: int):
+    """(query_rows, positions) buffered for `layer`, or (None, None). Host-side, outside the graph."""
+    buf = _query.get(int(layer))
+    count = _count.get(int(layer))
+    if buf is None or count is None:
+        return None, None
+    take = int(count.item())
+    if take <= 0:
+        return None, None
+    return buf[:take], (_positions[:take] if _positions is not None else None)
+
+
+def stats():
+    """Diagnostic: whether the compiled graph really calls the capture op."""
+    return {"op_calls": _op_calls, "armed": ARMED, "layers": len(_query),
+            "counts": {k: int(v.item()) for k, v in list(_count.items())[:4]}}
+
+
+def read_all():
+    return {layer: read(layer) for layer in list(_query)}
