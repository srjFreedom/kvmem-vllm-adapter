diff --git a/tests/v1/core/test_kvmem_reconstruction.py b/tests/v1/core/test_kvmem_reconstruction.py
new file mode 100644
index 0000000..1ea97ff
--- /dev/null
+++ b/tests/v1/core/test_kvmem_reconstruction.py
@@ -0,0 +1,265 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU-only reconstruction contract tests (also runnable with unittest directly).
+
+No weights, requests, model forward, CUDA allocation, or GPU inference is used.
+"""
+import threading
+import unittest
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import numpy as np
+import torch
+
+from vllm.sampling_params import SamplingParams
+from vllm.v1.core.sched.output import NewRequestData
+from vllm.v1.core.sched.request_queue import FCFSRequestQueue
+from vllm.v1.core.sched.scheduler import Scheduler
+from vllm.v1.kv_cache_interface import FullAttentionSpec, KVCacheGroupSpec, MambaSpec
+from vllm.v1.outputs import ModelRunnerOutput
+from vllm.v1.request import Request, RequestStatus
+from vllm.v1.worker.gpu.model_runner import GPUModelRunner
+from vllm.v1.worker.gpu.states import RequestState
+
+
+def make_scheduler(request):
+    # Exercise real scheduler methods without ModelConfig/weights/platform init.
+    scheduler = object.__new__(Scheduler)
+    scheduler.kvmem_resident = True
+    scheduler.kvmem_reconstruction_enabled = True
+    scheduler.use_v2_model_runner = True
+    scheduler.scheduler_config = SimpleNamespace(async_scheduling=False)
+    scheduler.cache_config = SimpleNamespace(enable_prefix_caching=False)
+    scheduler.kv_cache_config = SimpleNamespace(kv_cache_groups=[])
+    scheduler.use_pp = False
+    scheduler.max_model_len = 128
+    scheduler.connector = scheduler.ec_connector = None
+    scheduler._kvmem_reconstruction_lock = threading.Lock()
+    scheduler._kvmem_pending_reconstructions = {}
+    scheduler.requests = {request.request_id: request}
+    scheduler.running = [request]
+    scheduler.waiting = FCFSRequestQueue()
+    scheduler.encoder_cache_manager = Mock()
+    scheduler.kv_cache_manager = Mock()
+    scheduler.kv_cache_manager.take_events.return_value = None
+    scheduler._inflight_prefills = {request}
+    scheduler._prefill_barrier_admission_blocked = set()
+    scheduler.reset_preempted_req_ids = set()
+    scheduler.finished_req_ids = set()
+    scheduler.finished_req_ids_dict = None
+    scheduler.grammar_compile_error_reqs = set()
+    scheduler.defer_block_free = False
+    scheduler.log_stats = False
+    scheduler.perf_metrics = None
+    scheduler.enable_return_routed_experts = False
+    scheduler.make_stats = Mock(return_value=None)
+    return scheduler
+
+
+def make_request():
+    request = Request("r", list(range(16)), SamplingParams(max_tokens=8), None)
+    request.status = RequestStatus.RUNNING
+    request.num_computed_tokens = 8  # Earlier compaction shrank resident KV.
+    request.num_logical_tokens = 16
+    request.num_kvmem_offset = 8
+    request.num_in_flight_tokens = 4  # Final original prefill is executing.
+    return request
+
+
+def finish_prefill(scheduler, request, sample=99):
+    return scheduler.update_from_output(
+        SimpleNamespace(
+            num_scheduled_tokens={request.request_id: 4},
+            total_num_scheduled_tokens=4,
+        ),
+        ModelRunnerOutput(
+            req_ids=[request.request_id], req_id_to_index={request.request_id: 0},
+            sampled_token_ids=[[sample]],
+        ),
+    )
+
+
+class ReconstructionSchedulerTest(unittest.TestCase):
+    def test_queue_is_immutable_and_commit_drops_original_sample(self):
+        request = make_request()
+        original_prompt_reference = request.prompt_token_ids
+        scheduler = make_scheduler(request)
+        selected = [0, 1, 12, 13, 14, 15]
+        reply = scheduler.queue_kvmem_reconstruction("r", selected)
+        selected[0] = 999  # Sender cannot alter queued payload after acknowledgement.
+        self.assertTrue(reply["queued"])
+        self.assertEqual(request.num_logical_tokens, 16)
+        self.assertEqual(request.num_in_flight_tokens, 4)
+        self.assertEqual(list(request.all_token_ids), list(range(16)))
+        scheduler.kv_cache_manager.free.assert_not_called()
+        request.spec_token_ids = [97, 98]
+        request.num_output_placeholders = 3
+        request.block_hashes[:] = [b"old hash"]
+        result = finish_prefill(scheduler, request)
+        self.assertEqual(result, {})  # No token 99 can reach output processor.
+        self.assertEqual(list(request.output_token_ids), [])
+        self.assertEqual(list(request.all_token_ids), [0, 1, 12, 13, 14, 15])
+        self.assertEqual(request.prompt_token_ids, list(request.all_token_ids))
+        self.assertEqual(original_prompt_reference, list(range(16)))
+        self.assertEqual(request.kvmem_original_num_prompt_tokens, 16)
+        self.assertEqual(request.num_prompt_tokens, 6)
+        for field in ("num_in_flight_tokens", "num_logical_tokens", "num_computed_tokens",
+                      "num_kvmem_offset", "num_output_placeholders", "num_stale_output_tokens"):
+            self.assertEqual(getattr(request, field), 0, field)
+        self.assertEqual(request.spec_token_ids, [])
+        self.assertEqual(request.block_hashes, [])
+        self.assertEqual(scheduler.running, [])
+        self.assertIs(scheduler.waiting.peek_request(), request)
+        self.assertEqual(request.status, RequestStatus.PREEMPTED)
+        scheduler.kv_cache_manager.free.assert_called_once_with(request)
+        self.assertEqual(scheduler.reset_preempted_req_ids, {"r"})
+        # V2's resumed branch sends this exact NewRequestData form.
+        fresh = NewRequestData.from_request(request, ([2, 3],), request._all_token_ids)
+        self.assertTrue(fresh.kvmem_rebuilt)
+        self.assertEqual(fresh.prompt_len, 6)
+        self.assertEqual(fresh.prefill_token_ids, [0, 1, 12, 13, 14, 15])
+        self.assertEqual((fresh.num_computed_tokens, fresh.num_logical_tokens), (0, 0))
+
+    def test_tp_duplicates_and_conflicts_before_and_after_commit(self):
+        request = make_request()
+        scheduler = make_scheduler(request)
+        ids = [0, 1, 15]
+        first = scheduler.queue_kvmem_reconstruction("r", ids)
+        self.assertEqual(scheduler.queue_kvmem_reconstruction("r", ids), first)
+        with self.assertRaisesRegex(ValueError, "different reconstruction"):
+            scheduler.queue_kvmem_reconstruction("r", [0, 1, 14])
+        finish_prefill(scheduler, request)
+        reply = scheduler.queue_kvmem_reconstruction("r", ids)
+        self.assertEqual(reply["skipped"], "already rebuilt")
+        scheduler.kv_cache_manager.free.assert_called_once()
+        with self.assertRaisesRegex(ValueError, "conflicting reconstruction"):
+            scheduler.queue_kvmem_reconstruction("r", [0, 1, 14])
+
+    def test_rejects_unsupported_and_late_transitions_without_mutation(self):
+        for mutation in (
+            lambda s, r: setattr(s, "kvmem_reconstruction_enabled", False),
+            lambda s, r: setattr(s.scheduler_config, "async_scheduling", True),
+            lambda s, r: setattr(s, "use_pp", True),
+            lambda s, r: setattr(s, "use_v2_model_runner", False),
+            lambda s, r: setattr(s.cache_config, "enable_prefix_caching", True),
+            lambda s, r: setattr(r, "num_logical_tokens", 12),
+            lambda s, r: setattr(r, "num_in_flight_tokens", 0),
+            lambda s, r: r.append_output_token_ids(7),
+            lambda s, r: setattr(r, "mm_features", [object()]),
+            lambda s, r: setattr(r, "resumable", True),
+        ):
+            request = make_request()
+            scheduler = make_scheduler(request)
+            mutation(scheduler, request)
+            with self.assertRaises(ValueError):
+                scheduler.queue_kvmem_reconstruction("r", [0, 1, 15])
+            self.assertEqual(scheduler._kvmem_pending_reconstructions, {})
+            self.assertEqual(request.prompt_token_ids, list(range(16)))
+            scheduler.kv_cache_manager.free.assert_not_called()
+
+    def test_non_rebuilt_request_has_no_state_change(self):
+        request = make_request()
+        scheduler = make_scheduler(request)
+        self.assertFalse(scheduler._apply_kvmem_reconstruction(request))
+        self.assertFalse(request.kvmem_rebuilt)
+        self.assertEqual(request.num_computed_tokens, 8)
+        scheduler.kv_cache_manager.free.assert_not_called()
+
+
+class CpuStagedBuffer:
+    def __init__(self, shape):
+        self.np = np.full(shape, -7, dtype=np.int32)
+        self.gpu = torch.from_numpy(self.np)
+        self.pending = []
+
+    def stage_write_elem(self, index, value):
+        self.pending.append((index, value))
+
+    def stage_write(self, index, start, values):
+        self.pending.append(((index, slice(start, start + len(values))), list(values)))
+
+    def apply_write(self):
+        for index, value in self.pending:
+            self.np[index] = value
+        self.pending.clear()
+
+    def copy_to_uva(self):
+        pass
+
+
+def cpu_request_state():
+    state = object.__new__(RequestState)
+    state.req_id_to_index = {"r": 0}
+    state.index_to_req_id = {0: "r"}
+    state.free_indices = []
+    state.max_seq_len = np.array([99], dtype=np.int32)
+    state.prompt_len = CpuStagedBuffer(1)
+    state.prefill_len = CpuStagedBuffer(1)
+    state.total_len = CpuStagedBuffer(1)
+    state.all_token_ids = CpuStagedBuffer((1, 32))
+    state.num_computed_prefill_tokens = np.array([99], dtype=np.int32)
+    state.num_computed_tokens_np = np.array([99], dtype=np.int32)
+    state.num_computed_tokens = CpuStagedBuffer(1)
+    state.num_cached_tokens = CpuStagedBuffer(1)
+    state.num_logical_tokens_np = np.array([99], dtype=np.int32)
+    state.draft_tokens = torch.full((1, 4), 99, dtype=torch.int64)
+    state.last_sampled_tokens = torch.full((1, 1), 99, dtype=torch.int64)
+    state.next_prefill_tokens = torch.full((2, 1), 99, dtype=torch.int32)
+    return state
+
+
+class ReconstructionWorkerTest(unittest.TestCase):
+    def test_fresh_admission_replaces_state_on_each_tp_rank(self):
+        groups = [
+            KVCacheGroupSpec(["mamba"], MambaSpec(
+                block_size=128, shapes=((1,),), dtypes=(torch.float32,),
+                num_speculative_blocks=2)),
+            KVCacheGroupSpec(["attention"], FullAttentionSpec(
+                block_size=16, num_kv_heads=1, head_size=1, dtype=torch.float32)),
+        ]
+        for rank in (0, 1):
+            with self.subTest(rank=rank):
+                runner = object.__new__(GPUModelRunner)
+                runner.req_states = cpu_request_state()
+                runner.model_state = Mock()
+                runner.pooling_runner = runner.pp_handler = runner.encoder_cache = None
+                runner.prompt_logprobs_worker = Mock()
+                runner.lora_state = Mock()
+                runner.adaptive_verification = None
+                runner.is_last_pp_rank = True
+                runner.sampler = Mock()
+                runner.block_tables = Mock()
+                runner.kv_cache_config = SimpleNamespace(kv_cache_groups=groups)
+                runner.kv_cache_group_ids = [0, 1]
+                runner.kv_caches = [torch.ones((8, 1, 1, 16)) for _ in groups]
+                fresh = NewRequestData(
+                    req_id="r", prompt_token_ids=[2, 7, 13], prefill_token_ids=[2, 7, 13],
+                    mm_features=[], sampling_params=SamplingParams(max_tokens=8),
+                    pooling_params=None, lora_request=None, block_ids=([2, 4, 6], [3]),
+                    num_computed_tokens=0, num_logical_tokens=0, kvmem_rebuilt=True,
+                )
+                runner.add_requests(SimpleNamespace(scheduled_new_reqs=[fresh]))
+                states = runner.req_states
+                self.assertEqual(states.all_token_ids.np[0, :3].tolist(), [2, 7, 13])
+                self.assertEqual(int(states.prompt_len.np[0]), 3)
+                self.assertEqual(int(states.prefill_len.np[0]), 3)
+                self.assertEqual(int(states.total_len.np[0]), 3)
+                self.assertEqual(int(states.num_computed_tokens.np[0]), 0)
+                self.assertEqual(int(states.num_logical_tokens_np[0]), 0)
+                self.assertEqual(int(states.num_computed_tokens_np[0]), 0)
+                self.assertEqual(int(states.max_seq_len[0]), 11)
+                self.assertFalse(states.last_sampled_tokens.any())
+                self.assertFalse(states.next_prefill_tokens.any())
+                self.assertFalse(states.draft_tokens.any())
+                runner.model_state.remove_request.assert_called_once_with("r")
+                runner.model_state.add_request.assert_called_once_with(0, fresh)
+                runner.block_tables.append_block_ids.assert_called_once_with(
+                    0, ([2, 4, 6], [3]), overwrite=True)
+                self.assertFalse(runner.kv_caches[0][[2, 4, 6]].any())
+                self.assertTrue(runner.kv_caches[0][[0, 1, 3, 5, 7]].all())
+                self.assertTrue(runner.kv_caches[1].all())
+
+
+if __name__ == "__main__":
+    unittest.main()
