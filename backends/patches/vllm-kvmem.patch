new file mode 100644
index 0000000..298977f
--- /dev/null
+++ b/vllm/entrypoints/serve/speedmeter/api_router.py
@@ -0,0 +1,38 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Speedmeter endpoints: live prefill progress of running requests.
+
+GET /speedmeter/prefill ->
+    {"requests": [{"id": ..., "prompt_len": ..., "computed": ...}, ...]}
+
+`computed` starts at the prefix-cache hit length and only grows, so
+(prompt_len - computed) is the exact remaining prefill work and
+delta(computed)/delta(t) is the live prefill rate.
+"""
+
+from fastapi import APIRouter, FastAPI, Request
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+router = APIRouter()
+
+
+@router.get("/speedmeter/prefill")
+async def speedmeter_prefill(raw_request: Request):
+    """Prefill progress for every running request.
+
+    The data lives in the EngineCore process; we fetch it over the
+    generic UTILITY RPC channel (EngineCore.speedmeter_prefill), so this
+    works for both multiprocess and in-process deployments.
+    """
+    engine_client = raw_request.app.state.engine_client
+    requests = await engine_client.engine_core.call_utility_async(
+        "speedmeter_prefill"
+    )
+    return {"requests": requests}
+
+
+def attach_router(app: FastAPI):
+    app.include_router(router)
diff --git a/vllm/kvmem_bridge.py b/vllm/kvmem_bridge.py
new file mode 100644
index 0000000..324c872
--- /dev/null
+++ b/vllm/kvmem_bridge.py
@@ -0,0 +1,541 @@
+"""KVMem bridge: expose the current step's query to an out-of-tree policy layer.
+
+The hard constraint: under `torch.compile` (fullgraph) + CUDA Graph replay **no Python runs per
+decode step**, and the compiled region tolerates nothing that dynamo cannot trace - a graph break,
+an allocation, or a `torch` call returning a non-tensor all abort compilation (observed:
+"op returned non-Tensor", then "RuntimeError when making fake tensor call").
+
+So the copy lives in a **registered custom op**. Dynamo treats it as opaque, inductor emits the
+call into the graph, and the copies it performs are ordinary kernels that replay with the live
+buffers. Buffers are allocated once, from outside the graph (`ensure()`), by the adapter.
+
+Keys take the same route now: KVMem's design keeps its own mean-K statistics (`RawKvStore` with
+`n_layer = full-attention layers`, `n_embd_k = kv_heads*head_dim`, `block_tokens = 64`) and fills
+them from **device-side bucket sums of the pre-RoPE K**, exactly like the reference product
+program (`backends/ninfer/.../storage/memory_statistics.cpp: commit_memory_statistics`). The
+statistics store therefore needs no page bytes and no host-side dequantisation: the engine reduces
+per 64-token bucket while it already owns K, and the adapter only receives the small host copy of
+that step's bucket sums.
+"""
+from __future__ import annotations
+
+import os
+
+import torch
+
+# Arming is OWNED BY THE ADAPTER, not the environment: vLLM spawns EngineCore/workers with a
+# filtered env (measured: `KVMEM_CAPTURE` absent in Worker_TP* while `KVMEM_CAPTURE_TOKENS` in the
+# same prefix survived), so an env-gated op was a silent no-op in every engine process. `ensure()`
+# is only called by the adapter when it actually wants the capture, so its success IS the arm.
+ARMED_ENV = os.environ.get("KVMEM_CAPTURE", "0") == "1"
+_ARMED = False
+ARMED = False
+MAX_TOKENS = int(os.environ.get("KVMEM_CAPTURE_TOKENS", "64") or "64")
+# One vLLM step can hand the model up to `max_num_batched_tokens` rows (prefill chunk). The key
+# statistics only need one bucket row set per step, so this is a per-step capacity, not a context
+# buffer: the context-sized sums live in the adapter's RawKvStore.
+STEP_TOKENS = int(os.environ.get("KVMEM_CAPTURE_STEP_TOKENS", "8192") or "8192")
+BUCKET = 64
+
+_query: dict[int, torch.Tensor] = {}
+_count: dict[int, torch.Tensor] = {}
+_positions: torch.Tensor | None = None
+_pos_count: torch.Tensor | None = None
+_ready = False
+_op_calls = 0        # how many times the custom op body actually ran (diagnostic)
+# Per-layer capture instrumentation. `_bad[layer]` is a DEVICE flag OR-ed on every capture (no host
+# sync in the hot path), so a harvest can say WHICH layers ever received a non-finite query and how
+# many times each layer was called at all - a zero query and a NaN query look identical otherwise.
+_bad: dict[int, torch.Tensor] = {}
+_calls: dict[int, int] = {}          # host counter, cheap (pure Python)
+_shapes: dict[int, tuple] = {}       # layer -> last (rows, heads, dim) written
+_probe: dict[int, list] = {}         # layer -> first few payload magnitudes (n, rows, absmax, pos)
+_nan: dict[int, torch.Tensor] = {}   # layer -> accumulated count of NaN elements ever seen
+_inf: dict[int, torch.Tensor] = {}   # layer -> accumulated count of inf elements ever seen
+# --- key statistics (mean-K) -------------------------------------------------------------
+# One FP32 sum row set per layer per step, indexed by `position // 64 - base` where base is the
+# step's first bucket. The adapter drains it every step (D2H) and writes it into kvmem's
+# RawKvStore, which is the only owner of the context-sized statistics.
+_KACC: dict[int, torch.Tensor] = {}   # layer -> (buckets, width) FP32 bucket sums
+_KROWS: dict[int, torch.Tensor] = {}  # layer -> (STEP_TOKENS, width) FP32 pre-RoPE K scratch
+_KIDX: dict[int, torch.Tensor] = {}   # layer -> (STEP_TOKENS,) int64 bucket index
+_KFLAG: dict[int, torch.Tensor] = {}  # layer -> (1,) int32 "a non-finite key was seen"
+# Geometry mismatches and refusals, counted so a silent drop can never masquerade as "no keys yet".
+# One reusable PAGEABLE host buffer per layer for the bucket drain. The drain runs once per step per
+# layer; allocating a fresh host tensor each time (`.to("cpu")`) put sustained pressure on the CUDA
+# pinned allocator and killed the engine at 88K ("Exception in pinned allocator free()"). Pageable,
+# not pinned: the copy is already a sync and pinning buys nothing here.
+_KHOST: dict[int, torch.Tensor] = {}
+# How many leading rows of a step may enter the bucket sums. 0 = all of them. On a decode step the
+# model writes 1 target + K draft rows, and only the target is guaranteed accepted; limiting the
+# accumulation to that first row keeps the statistics on the ACCEPTED timeline instead of letting
+# rejected drafts bias every bucket's mean key.
+KEY_ROWS_LIMIT = 0
+# Decode steps keep their (few) pre-RoPE rows instead of folding them into bucket sums: how many of
+# them were ACCEPTED is only known after the step, and a rejected draft must not enter the mean key.
+# Prefill chunks (thousands of rows) keep the bucket-sum path.
+ROWS_KEEP_MAX = 8
+_KEEP: dict[int, torch.Tensor] = {}
+_KEEP_N: dict[int, int] = {}
+_K_MISMATCH = [0]
+_K_MISMATCH_INFO: dict = {}
+_KV_HEADS = 0
+_KEY_WIDTH = 0
+_K_BUCKETS = 0
+# The model sees the COMPACTED position of a token; KVMem's statistics are keyed by the token's
+# TRUE (original) position, exactly like upstream, whose native execution keeps original RoPE
+# positions. The offset is a device tensor, not a Python constant, so a compiled graph keeps
+# reading the live value instead of a value baked in at trace time.
+_pos_offset: torch.Tensor | None = None
+
+
+def ensure(layers: int, heads: int, head_dim: int, device="cuda", max_tokens: int | None = None,
+           dtype: torch.dtype = torch.bfloat16, kv_heads: int | None = None,
+           force: bool = False) -> bool:
+    """Allocate the buffers. Must be called outside any compiled region (adapter does this)."""
+    global _positions, _pos_count, _ready, _KV_HEADS, _KEY_WIDTH, _K_BUCKETS, _pos_offset
+    global _ARMED, ARMED
+    take = int(max_tokens or MAX_TOKENS)
+    # Allocate ONCE per process. The compiled graph and its CUDA-graph replay capture the buffer
+    # pointers, so re-allocating later would leave the kernels writing into the old (freed) tensors
+    # while `read()` looks at the new ones - which is exactly how the query silently vanished.
+    if _ready and not force:
+        return True
+    if force:
+        # AT A REQUEST BOUNDARY ONLY (no capture in flight): the geometry was wrong, so drop every
+        # buffer and rebuild at the right width. Swapping buffers mid-step killed EngineCore
+        # (EngineDeadError), which is why this is never done from the post-step hook.
+        for table in (_query, _count, _bad, _nan, _inf, _KACC, _KROWS, _KIDX, _KFLAG):
+            table.clear()
+    # Build into locals and publish only on success: a half-built bridge (some layers allocated,
+    # `_KV_HEADS` still 0) crashed the engine during warmup with `width // 0` after a CUDA OOM
+    # swallowed the allocation loop.
+    rows: dict[int, torch.Tensor] = {}
+    acc: dict[int, torch.Tensor] = {}
+    idx: dict[int, torch.Tensor] = {}
+    flag: dict[int, torch.Tensor] = {}
+    query: dict[int, torch.Tensor] = {}
+    count: dict[int, torch.Tensor] = {}
+    bad: dict[int, torch.Tensor] = {}
+    nan: dict[int, torch.Tensor] = {}
+    inf: dict[int, torch.Tensor] = {}
+    calls: dict[int, int] = {}
+    slab = None
+    ibuf = None
+    positions = None
+    pos_count = None
+    pos_offset = None
+    try:
+        kvh = int(kv_heads or heads)
+        width = kvh * int(head_dim)
+        buckets = STEP_TOKENS // BUCKET + 2
+        # ONE scratch row set for all layers: layers run sequentially inside a step and the bucket
+        # sums are what must persist per layer, so 16 private (tokens x width) FP32 scratches would
+        # cost 16x the memory for nothing (measured: 536 MiB, which OOMed the KV pool fit).
+        slab = torch.zeros(STEP_TOKENS, width, dtype=torch.float32, device=device)
+        ibuf = torch.zeros(STEP_TOKENS, dtype=torch.int64, device=device)
+        for layer in range(int(layers)):
+            query[layer] = torch.zeros(take, int(heads), int(head_dim), dtype=dtype,
+                                       device=device)
+            count[layer] = torch.zeros(1, dtype=torch.int32, device=device)
+            bad[layer] = torch.zeros(1, dtype=torch.int32, device=device)
+            nan[layer] = torch.zeros(1, dtype=torch.int64, device=device)
+            inf[layer] = torch.zeros(1, dtype=torch.int64, device=device)
+            calls[layer] = 0
+            acc[layer] = torch.zeros(buckets, width, dtype=torch.float32, device=device)
+            rows[layer] = slab
+            idx[layer] = ibuf
+            flag[layer] = torch.zeros(1, dtype=torch.int32, device=device)
+        positions = torch.zeros(take, dtype=torch.int64, device=device)
+        pos_count = torch.zeros(1, dtype=torch.int32, device=device)
+        pos_offset = torch.zeros(1, dtype=torch.int64, device=device)
+    except Exception:
+        _ready = False
+        return False
+    _query.update(query)
+    _count.update(count)
+    _bad.update(bad)
+    _nan.update(nan)
+    _inf.update(inf)
+    _KACC.update(acc)
+    _KROWS.update(rows)
+    _KIDX.update(idx)
+    _KFLAG.update(flag)
+    _calls.update(calls)
+    _ARMED = True
+    ARMED = True
+    _positions = positions
+    _pos_count = pos_count
+    _pos_offset = pos_offset
+    _KV_HEADS = int(kv_heads or heads)
+    _KEY_WIDTH = _KV_HEADS * int(head_dim)
+    _K_BUCKETS = STEP_TOKENS // BUCKET + 2
+    _ready = True
+    return True
+
+
+# `mutates_args=("query",)` is what keeps inductor from deleting this node: an op with no declared
+# mutation and a None result looks pure, and the graph compiler drops it (measured: the op body ran
+# zero times after a clean compile). The op does not actually modify the query.
+# The buffer holds PRE-RoPE query rows, which is what kvmem's PageQueryView means by a query row
+# ("Post-normalization, pre-RoPE Q"). This fork fuses norm+rope, so the op inverts the rotation with
+# the token's own position - exact, because RoPE is an orthogonal rotation per position pair. Doing
+# it here removes the host-side un-rotate the adapter used to apply to every captured page.
+PRE_ROPE = True
+
+
+def pre_rope() -> bool:
+    """True when `read()` hands out pre-RoPE rows (the adapter must not rotate them again)."""
+    return PRE_ROPE
+
+
+@torch.library.custom_op("kvmem::capture_q", mutates_args=("query",))
+def capture_q(query: torch.Tensor, positions: torch.Tensor,
+              cos_sin_cache: torch.Tensor | None, rotary_dim: int, layer: int) -> None:
+    """Opaque to dynamo; the body below is plain tensor work executed at capture/replay time."""
+    global _op_calls
+    _op_calls += 1
+    if not _ARMED:
+        return None
+    layer = int(layer)
+    buf = _query.get(layer)
+    pos_buf = _positions
+    if buf is None or pos_buf is None or _pos_count is None:
+        return None
+    # The model hands us a flat [tokens, heads*head_dim] tensor; the buffer is [tokens, heads, dim].
+    if query.dim() == 2 and buf.dim() == 3:
+        query = query.view(query.shape[0], buf.shape[1], buf.shape[2])
+    n = query.shape[0]
+    take = MAX_TOKENS if n > MAX_TOKENS else n
+    # Keep a FINITE payload only. A non-finite query poisons the whole retrieval ranking (the layer
+    # mean becomes NaN, every cosine NaN, and the compacted view then keeps arbitrary blocks instead
+    # of the ones matching the question), so a bad step must leave the previous good payload in
+    # place instead of overwriting it. `torch.where` needs only the device-side predicate, so this
+    # still performs no host synchronisation in the hot path.
+    src = query[n - MAX_TOKENS:] if n > MAX_TOKENS else query
+    dst = buf if n > MAX_TOKENS else buf[:n]
+    take = dst.shape[0]
+    rows = src.to(torch.float32)
+    rd = int(rotary_dim)
+    if rd > 0 and rd % 2 == 0 and rows.shape[-1] >= rd and cos_sin_cache is not None:
+        half = rd // 2
+        pos = positions if positions.ndim == 1 else positions[0]
+        pos = pos[n - MAX_TOKENS:] if n > MAX_TOKENS else pos
+        table = cos_sin_cache.index_select(0, pos)          # (rows, rd) = [cos | sin]
+        cos = table[:, :half].unsqueeze(-2)                  # (rows, 1, half)
+        sin = table[:, half:rd].unsqueeze(-2)
+        x1 = rows[..., :half]
+        x2 = rows[..., half:rd]
+        rows = rows.clone()
+        rows[..., :half] = x1 * cos + x2 * sin               # inverse rotation
+        rows[..., half:rd] = x2 * cos - x1 * sin
+    try:
+        ok_all = torch.isfinite(rows).all()
+        torch.where(torch.isfinite(rows), rows.to(dst.dtype), dst, out=dst)
+    except Exception:
+        ok_all = None
+        dst.copy_(rows.to(dst.dtype))
+    # M-RoPE hands in [3, tokens] (one row per spatial axis); text is the identity, so the first
+    # row is the token position. Flattening it instead made 3*tokens values for n tokens.
+    pos = positions if positions.ndim == 1 else positions[0]
+    if n > MAX_TOKENS:
+        pos_buf.copy_(pos[n - MAX_TOKENS:])
+    else:
+        pos_buf[:n].copy_(pos)
+    # The published length may only advance when the WHOLE payload was finite: `read()` returns
+    # `buf[:count]`, so advancing `count` after keeping the previous payload would hand out a mix of
+    # old rows and whatever the bad step left behind. Device-side select, so no host sync.
+    try:
+        cnt_val = torch.full_like(_count[layer], take)
+        if ok_all is not None:
+            cnt_val = torch.where(ok_all, cnt_val, _count[layer])
+        _count[layer].copy_(cnt_val)
+        _pos_count.copy_(torch.where(cnt_val > 0, cnt_val, _pos_count))
+    except Exception:
+        _count[layer].fill_(take)
+        _pos_count.fill_(take)
+    # Evidence counters, all DEVICE side (no `.item()`), so the harvest can report exactly how much
+    # of the query was non-finite without disturbing the hot path.
+    try:
+        _calls[layer] = int(_calls.get(layer, 0)) + 1
+        _shapes[layer] = tuple(int(d) for d in query.shape)
+        flag = _bad.get(layer)
+        if flag is not None:
+            flag[0] += (~torch.isfinite(query)).any().to(torch.int32)
+        nanc = _nan.get(layer)
+        if nanc is not None:
+            nanc[0] += torch.isnan(query).sum()
+        infc = _inf.get(layer)
+        if infc is not None:
+            infc[0] += torch.isinf(query).sum()
+        # Probe the FIRST few payloads of every layer with a host sync. That is the window that
+        # answers "was the query already broken during prefill, or only for the step that happened to
+        # write last?" - and it costs nothing in steady state because it stops after PROBE_CALLS.
+        if int(_calls[layer]) <= 5:
+            rec = _probe.setdefault(int(layer), [])
+            rec.append({"n": int(n), "rows": int(query.shape[0]),
+                        "absmax": float(query.abs().max()),
+                        "pos": [int(v) for v in pos[:3].tolist()] if pos is not None else None})
+    except Exception:
+        pass
+    # NOTE: no `.item()` / host sync here. This body also runs while CUDA graphs are being captured,
+    # where a device->host synchronisation aborts the capture ("operation failed due to a previous
+    # error during capture").
+    return None
+
+
+@capture_q.register_fake
