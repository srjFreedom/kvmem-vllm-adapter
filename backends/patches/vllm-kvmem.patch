+# SPDX-License-Identifier: Apache-2.0
+"""Logical context cap for KVMem's resident-book mode.
+
+With in-request compaction the engine holds only `B + R` of KV per request while the conversation
+may grow to kvmem's logical ceiling (CTX). The request-length checks in the OpenAI entrypoints must
+therefore compare against CTX, not against the engine window (`max_model_len`), which is sized for
+the resident pool.
+"""
+import os
+
+
+def logical_max_len(max_model_len: int) -> int:
+    """`max_model_len`, or kvmem's CTX when in-request compaction is on."""
+    try:
+        if os.environ.get("KVMEM_ENTRY_INREQUEST_COMPACTION", "").strip().lower() not in (
+                "1", "true", "yes", "on"):
+            return int(max_model_len)
+        ctx = int(os.environ.get("KVMEM_ENTRY_CTX") or 0)
+    except Exception:
+        return int(max_model_len)
+    return ctx if ctx > 0 else int(max_model_len)
