+# `mutates_args` again only to keep the node: the op writes module-owned buffers, never `key`.
+@torch.library.custom_op("kvmem::capture_k", mutates_args=("key",))
+def capture_k(key: torch.Tensor, positions: torch.Tensor, cos_sin_cache: torch.Tensor | None,
+              rotary_dim: int, layer: int) -> None:
+    """Accumulate this step's pre-RoPE K into per-64-token bucket sums (FP32).
+
+    Upstream fills the same statistic inside its own kernel, where K is still pre-RoPE
+    (`memory_statistics.cpp: commit_memory_statistics -> RawKvStore::write_layer_mean_sum`).
+    This fork fuses norm+rope into one Triton kernel, so pre-RoPE K never materialises; rotating
+    back with the token's own position is exact (RoPE is an orthogonal rotation per position
+    pair) and reproduces precisely what upstream sums: the bucket's token sum of the pre-RoPE key.
+    """
+    if not _ARMED or not _ready or _KV_HEADS <= 0:
+        return None
+    layer = int(layer)
+    acc = _KACC.get(layer)
+    rows = _KROWS.get(layer)
+    idx = _KIDX.get(layer)
+    if acc is None or rows is None or idx is None:
+        return None
+    # M-RoPE hands in [3, tokens] (one row per spatial axis); the text identity is the first row.
+    # Indexing a 2-D tensor here raised "Index is supposed to be an empty tensor or a vector" during
+    # the warmup pass (which is the one place this fork feeds 3-row positions).
+    if positions.dim() != 1:
+        positions = positions[0] if positions.dim() == 2 else positions.reshape(-1)
+    width = int(acc.shape[1])
+    if int(key.shape[-1]) != width or width % _KV_HEADS:
+        # A configured width that disagrees with the model's own KV width is a real geometry error.
+        # It used to `return None` silently, and that is exactly how EVERY key was dropped while the
+        # statistics store kept filling with zeros (measured: mean_k absmax = 0 on every block,
+        # core scores all 0.0 while the legacy index ranked normally). Record it, loudly.
+        _K_MISMATCH[0] = int(_K_MISMATCH[0]) + 1
+        if _K_MISMATCH[0] == 1:
+            _K_MISMATCH_INFO.update({"key_cols": int(key.shape[-1]), "width": width,
+                                     "kv_heads": int(_KV_HEADS)})
+        return None
+    n = int(min(int(key.shape[0]), int(rows.shape[0])))
+    if KEY_ROWS_LIMIT:
+        n = min(n, int(KEY_ROWS_LIMIT))
+    if n <= 0:
+        return None
+    x = key[:n].to(torch.float32)
+    if x.dim() == 2:
+        x = x.view(n, _KV_HEADS, width // _KV_HEADS)
+    out = rows[:n].view(n, _KV_HEADS, width // _KV_HEADS)
+    out.copy_(x)
+    rd = int(rotary_dim)
+    if rd > 0 and rd % 2 == 0 and x.shape[-1] >= rd and cos_sin_cache is not None:
+        half = rd // 2
+        table = cos_sin_cache.index_select(0, positions[:n])   # (n, rd) = [cos | sin]
+        cos = table[:, :half].unsqueeze(1)                     # (n, 1, half)
+        sin = table[:, half:rd].unsqueeze(1)
+        x1 = x[..., :half]
+        x2 = x[..., half:rd]
+        out[..., :half].copy_(x1 * cos + x2 * sin)             # inverse rotation
+        out[..., half:rd].copy_(x2 * cos - x1 * sin)
+    # A non-finite key row must never enter the statistics: one NaN poisons that bucket's mean key
+    # and every cosine that reads it. Scrub in place and record the layer (device side, no sync).
+    finite = torch.isfinite(out)
+    try:
+        flag = _KFLAG.get(layer)
+        if flag is not None:
+            flag[0] += (~finite.all()).to(torch.int32)
+    except Exception:
+        pass
+    out.nan_to_num_(0.0, 0.0, 0.0)
+    if n <= ROWS_KEEP_MAX:
+        # Decode: publish the rows themselves; the harvest folds the accepted ones.
+        keep = _KEEP.get(layer)
+        if keep is None or keep.shape[1] != width:
+            keep = torch.zeros(ROWS_KEEP_MAX, width, dtype=torch.float32, device=out.device)
+            _KEEP[layer] = keep
+        keep[:n].copy_(out.view(n, width))
+        _KEEP_N[layer] = n
+        return None
+    # Bucket index: absolute TRUE bucket minus this step's first TRUE bucket, so one row set per
+    # layer per step is enough no matter how far into the context the step sits.
+    try:
+        off = _pos_offset[0] if _pos_offset is not None else 0
+        true_pos = positions[:n] + off
+        base = true_pos[0] // BUCKET
+        bidx = (true_pos // BUCKET) - base
+        torch.clamp(bidx, 0, acc.shape[0] - 1, out=idx[:n])
+        acc.index_add_(0, idx[:n], out.view(n, width))
+    except Exception:
+        pass
+    return None
+
+
+@capture_k.register_fake
+def _(key, positions, cos_sin_cache, rotary_dim, layer):
+    return None
+
+
+def set_position_offset(offset: int) -> None:
+    """Publish the compacted->true position offset for the coming step (host side, outside the graph).
+
+    The model runs at compacted positions once the adapter has compacted a request, while KVMem's
+    statistics are keyed by the token's true position. The op reads this device tensor, so a CUDA
+    graph replays with the live value.
+    """
+    if _pos_offset is None:
+        return
+    try:
+        _pos_offset.fill_(int(offset))
+    except Exception:
+        pass
+
+
+def step_tokens() -> int:
+    """How many token rows the last captured step carried (host sync; step boundary only).
+
+    NOTE: the query window is the last `MAX_TOKENS` tokens, so this is the QUERY row count, not
+    necessarily the step's scheduled token count. Bucket boundaries are derived by the adapter from
+    the scheduler's own (start, count) pair, never from this buffer.
+    """
+    if _pos_count is None:
+        return 0
+    return int(_pos_count.item())
+
+
+def read_key_rows(layer: int, take: int):
+    """Host copy of the first `take` kept decode rows for `layer` (empty tensor when none)."""
